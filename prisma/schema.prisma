datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// GRUPO 1: AUTENTICACIÓN, USUARIOS, ROLES, PERMISOS Y MEMBRESÍAS (#01 a #07)
// =============================================================================

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(80)
  status    String   @default("ACTIVE") @db.VarChar(20)
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id], map: "tenants_pkey")
  @@map("tenants")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique @db.VarChar(255)
  fullName            String    @map("full_name") @db.VarChar(150)
  passwordHash        String    @map("password_hash")
  status              String    @default("ACTIVE") @db.VarChar(20)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(50)
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantMembership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  invitedBy String?  @map("invited_by") @db.Uuid
  status    String   @default("ACTIVE") @db.VarChar(20)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([userId, tenantId, id])
  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  membershipId   String?   @map("membership_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?   @map("revoked_reason") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sessions")
}

// =============================================================================
// GRUPO 2: CATÁLOGOS HÍBRIDOS (#08 a #17)
// =============================================================================

model CollectiveAgreement {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String?  @map("tenant_id") @db.Uuid
  cctNumber                   String   @map("cct_number") @db.VarChar(30)
  name                        String   @db.VarChar(200)
  unionName                   String   @map("union_name") @db.VarChar(150)
  activity                    String   @db.VarChar(200)
  territorialScope            String   @map("territorial_scope") @db.VarChar(150)
  defaultRemunerationModality String   @map("default_remuneration_modality") @db.VarChar(20)
  defaultPaymentFrequency     String   @map("default_payment_frequency") @db.VarChar(20)
  standardMonthlyHours        Decimal  @default(200.00) @map("standard_monthly_hours") @db.Decimal(8, 2)
  standardQuincenalHours      Decimal? @default(96.00) @map("standard_quincenal_hours") @db.Decimal(8, 2)
  seniorityComputationRule    Json     @default("{}") @map("seniority_computation_rule")
  overtimeRule                Json     @default("{}") @map("overtime_rule")
  holidayRule                 Json     @default("{}") @map("holiday_rule")
  vacationRule                Json     @default("{}") @map("vacation_rule")
  isActive                    Boolean  @default(true) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("collective_agreements")
}

model AgreementBranch {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?  @map("tenant_id") @db.Uuid
  agreementId             String   @map("agreement_id") @db.Uuid
  code                    String   @db.VarChar(40)
  name                    String   @db.VarChar(200)
  referenceMonthlyHours   Decimal  @default(192.00) @map("reference_monthly_hours") @db.Decimal(8, 2)
  referenceQuincenalHours Decimal? @default(96.00) @map("reference_quincenal_hours") @db.Decimal(8, 2)
  specificRules           Json     @default("{}") @map("specific_rules")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agreementId, id])
  @@unique([agreementId, code])
  @@map("agreement_branches")
}

model AgreementCategory {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?  @map("tenant_id") @db.Uuid
  agreementId             String   @map("agreement_id") @db.Uuid
  branchId                String   @map("branch_id") @db.Uuid
  code                    String   @db.VarChar(40)
  name                    String   @db.VarChar(150)
  remunerationModality    String   @map("remuneration_modality") @db.VarChar(20)
  remunerationUnit        String   @map("remuneration_unit") @db.VarChar(20)
  defaultPaymentFrequency String   @map("default_payment_frequency") @db.VarChar(20)
  hierarchyOrder          Int      @default(100) @map("hierarchy_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agreementId, branchId, id])
  @@unique([branchId, code])
  @@map("agreement_categories")
}

model SalaryScale {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?   @map("tenant_id") @db.Uuid
  agreementId             String    @map("agreement_id") @db.Uuid
  branchId                String    @map("branch_id") @db.Uuid
  supersededById          String?   @map("superseded_by_id") @db.Uuid
  version                 Int       @default(1)
  agreementNumber         String    @map("agreement_number") @db.VarChar(120)
  homologationDisposition String?   @map("homologation_disposition") @db.VarChar(150)
  periodCode              String    @map("period_code") @db.Char(7)
  validFrom               DateTime  @map("valid_from") @db.Date
  validTo                 DateTime  @map("valid_to") @db.Date
  status                  String    @default("PENDING_VALIDATION") @db.VarChar(25)
  sourceDocumentRef       String?   @map("source_document_ref")
  validatedBy             String?   @map("validated_by") @db.Uuid
  validatedAt             DateTime? @map("validated_at") @db.Timestamptz(6)
  notes                   String?
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([agreementId, branchId, id])
  @@map("salary_scales")
}

model SalaryScaleItem {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?  @map("tenant_id") @db.Uuid
  salaryScaleId           String   @map("salary_scale_id") @db.Uuid
  agreementId             String   @map("agreement_id") @db.Uuid
  branchId                String   @map("branch_id") @db.Uuid
  categoryId              String   @map("category_id") @db.Uuid
  hourlyRate              Decimal? @map("hourly_rate") @db.Decimal(18, 6)
  dailyRate               Decimal? @map("daily_rate") @db.Decimal(18, 6)
  monthlyBasic            Decimal? @map("monthly_basic") @db.Decimal(18, 2)
  remunerativeAdditionals Json     @default("[]") @map("remunerative_additionals")
  nonRemunerativeConcepts Json     @default("[]") @map("non_remunerative_concepts")
  fixedAmounts            Json     @default("{}") @map("fixed_amounts")
  percentages             Json     @default("{}")
  notes                   String?

  @@unique([salaryScaleId, categoryId])
  @@map("salary_scale_items")
}

model PayrollConcept {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?  @map("tenant_id") @db.Uuid
  agreementId             String?  @map("agreement_id") @db.Uuid
  code                    String   @db.VarChar(30)
  name                    String   @db.VarChar(150)
  nature                  String   @db.VarChar(30)
  defaultUnit             String   @map("default_unit") @db.VarChar(20)
  accrualScope            String   @map("accrual_scope") @db.VarChar(30)
  printOrder              Int      @default(100) @map("print_order")
  taxPrevisionalTreatment Json     @default("{}") @map("tax_previsional_treatment")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payroll_concepts")
}

model PayrollRule {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                     String?   @map("tenant_id") @db.Uuid
  conceptId                    String    @map("concept_id") @db.Uuid
  agreementId                  String?   @map("agreement_id") @db.Uuid
  branchId                     String?   @map("branch_id") @db.Uuid
  version                      Int       @default(1)
  ruleCode                     String    @map("rule_code") @db.VarChar(60)
  applicableModalities         String[]  @map("applicable_modalities")
  applicableRemunerationTypes  String[]  @map("applicable_remuneration_types")
  applicablePaymentFrequencies String[]  @map("applicable_payment_frequencies")
  quantityFormula              String?   @map("quantity_formula")
  baseFormula                  String    @map("base_formula")
  rateFormula                  String?   @map("rate_formula")
  amountFormula                String    @map("amount_formula")
  conditionsExpression         String?   @map("conditions_expression")
  exceptionsJson               Json      @default("[]") @map("exceptions_json")
  capMinParamCode              String?   @map("cap_min_param_code") @db.VarChar(60)
  capMaxParamCode              String?   @map("cap_max_param_code") @db.VarChar(60)
  normativeSource              String    @map("normative_source") @db.VarChar(200)
  normativeArticle             String    @map("normative_article") @db.VarChar(150)
  territorialOrActivityScope   String    @map("territorial_or_activity_scope") @db.VarChar(150)
  consultedAt                  DateTime  @map("consulted_at") @db.Date
  validFrom                    DateTime  @map("valid_from") @db.Date
  validTo                      DateTime? @map("valid_to") @db.Date
  validationStatus             String    @default("PENDING_VALIDATION") @map("validation_status") @db.VarChar(30)
  validatedBy                  String?   @map("validated_by") @db.Uuid
  validatedAt                  DateTime? @map("validated_at") @db.Timestamptz(6)
  observations                 String?
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([conceptId, id])
  @@unique([conceptId, version])
  @@map("payroll_rules")
}

model SystemParameter {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String?   @map("tenant_id") @db.Uuid
  code                String    @db.VarChar(60)
  name                String    @db.VarChar(150)
  version             Int       @default(1)
  numericValue        Decimal?  @map("numeric_value") @db.Decimal(18, 6)
  jsonValue           Json?     @map("json_value")
  normativeSource     String    @map("normative_source") @db.VarChar(200)
  normativeResolution String    @map("normative_resolution") @db.VarChar(150)
  consultedAt         DateTime  @map("consulted_at") @db.Date
  validFrom           DateTime  @map("valid_from") @db.Date
  validTo             DateTime? @map("valid_to") @db.Date
  validationStatus    String    @default("PENDING_VALIDATION") @map("validation_status") @db.VarChar(30)
  observations        String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("system_parameters")
}

model HolidayCalendar {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?  @map("tenant_id") @db.Uuid
  agreementId       String?  @map("agreement_id") @db.Uuid
  holidayDate       DateTime @map("holiday_date") @db.Date
  name              String   @db.VarChar(150)
  holidayType       String   @map("holiday_type") @db.VarChar(30)
  province          String?  @db.VarChar(80)
  locality          String?  @db.VarChar(100)
  isBankBusinessDay Boolean  @default(false) @map("is_bank_business_day")
  normativeSource   String   @map("normative_source") @db.VarChar(150)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("holiday_calendars")
}

model PayrollNoveltyType {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String? @map("tenant_id") @db.Uuid
  linkedConceptId       String? @map("linked_concept_id") @db.Uuid
  code                  String  @db.VarChar(40)
  name                  String  @db.VarChar(120)
  groupCategory         String  @map("group_category") @db.VarChar(30)
  defaultUnit           String  @map("default_unit") @db.VarChar(20)
  requiresJustification Boolean @default(false) @map("requires_justification")
  requiresDocument      Boolean @default(false) @map("requires_document")
  isActive              Boolean @default(true) @map("is_active")

  @@map("payroll_novelty_types")
}

// =============================================================================
// GRUPO 3: DATOS MAESTROS, LEGAJOS, DOCUMENTOS Y STAGING PRIVADOS (#18 a #30)
// =============================================================================

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  cuit           String    @db.Char(11)
  currentVersion Int       @default(1) @map("current_version")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, cuit])
  @@map("companies")
}

model CompanyVersion {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  version                 Int
  validFrom               DateTime  @map("valid_from") @db.Date
  validTo                 DateTime? @map("valid_to") @db.Date
  legalName               String    @map("legal_name") @db.VarChar(200)
  tradeName               String?   @map("trade_name") @db.VarChar(200)
  personType              String    @map("person_type") @db.VarChar(20)
  companyType             String    @map("company_type") @db.VarChar(60)
  holderOrRepresentatives String?   @map("holder_or_representatives") @db.VarChar(250)
  registrationDate        DateTime? @map("registration_date") @db.Date
  activityStartDate       DateTime  @map("activity_start_date") @db.Date
  mainActivity            String    @map("main_activity") @db.VarChar(200)
  secondaryActivities     String?   @map("secondary_activities")
  arcaActivityCode        String    @map("arca_activity_code") @db.VarChar(20)
  vatCondition            String    @map("vat_condition") @db.VarChar(60)
  fiscalAddress           String    @map("fiscal_address") @db.VarChar(250)
  legalAddress            String    @map("legal_address") @db.VarChar(250)
  commercialAddress       String?   @map("commercial_address") @db.VarChar(250)
  province                String    @db.VarChar(80)
  locality                String    @db.VarChar(100)
  postalCode              String    @map("postal_code") @db.VarChar(20)
  phone                   String?   @db.VarChar(50)
  email                   String    @db.VarChar(150)
  registrationNumbers     Json      @default("{}") @map("registration_numbers")
  bankName                String?   @map("bank_name") @db.VarChar(100)
  cbu                     String?   @db.Char(22)
  artName                 String    @map("art_name") @db.VarChar(120)
  artAliquotPct           Decimal   @default(0) @map("art_aliquot_pct") @db.Decimal(10, 6)
  artFixedAmount          Decimal   @default(0) @map("art_fixed_amount") @db.Decimal(18, 2)
  institutionalObraSocial String?   @map("institutional_obra_social") @db.VarChar(150)
  paymentScheduleRule     Json      @default("{\"businessDaysAfterClose\": 4}") @map("payment_schedule_rule")
  createdBy               String    @map("created_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@unique([companyId, version])
  @@map("company_versions")
}

model CompanyBranch {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  code               String   @db.VarChar(30)
  name               String   @db.VarChar(150)
  address            String   @db.VarChar(250)
  locality           String   @db.VarChar(100)
  province           String   @db.VarChar(80)
  postalCode         String   @map("postal_code") @db.VarChar(20)
  identificationData Json     @default("{}") @map("identification_data")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@unique([tenantId, companyId, code])
  @@map("company_branches")
}

model CompanyAgreement {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  companyId                String   @map("company_id") @db.Uuid
  agreementId              String   @map("agreement_id") @db.Uuid
  branchId                 String?  @map("branch_id") @db.Uuid
  confirmedBy              String   @map("confirmed_by") @db.Uuid
  confirmedAt              DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  paymentFrequencyOverride String?  @map("payment_frequency_override") @db.VarChar(20)
  customParameters         Json     @default("{}") @map("custom_parameters")
  isActive                 Boolean  @default(true) @map("is_active")

  @@unique([tenantId, id])
  @@map("company_agreements")
}

model Employee {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  cuil                  String    @db.Char(11)
  dni                   String    @db.VarChar(12)
  legajo                String    @db.VarChar(30)
  currentVersion        Int       @default(1) @map("current_version")
  employmentStatus      String    @default("ACTIVE") @map("employment_status") @db.VarChar(30)
  hireDate              DateTime  @map("hire_date") @db.Date
  terminationDate       DateTime? @map("termination_date") @db.Date
  recognizedPriorYears  Int       @default(0) @map("recognized_prior_years")
  recognizedPriorMonths Int       @default(0) @map("recognized_prior_months")
  recognizedPriorDays   Int       @default(0) @map("recognized_prior_days")
  priorServicesNotes    String?   @map("prior_services_notes")
  createdBy             String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@unique([tenantId, companyId, cuil])
  @@unique([tenantId, companyId, legajo])
  @@map("employees")
}

model EmployeeVersion {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  companyId                 String    @map("company_id") @db.Uuid
  employeeId                String    @map("employee_id") @db.Uuid
  branchId                  String    @map("branch_id") @db.Uuid
  agreementId               String    @map("agreement_id") @db.Uuid
  agreementBranchId         String    @map("agreement_branch_id") @db.Uuid
  categoryId                String    @map("category_id") @db.Uuid
  version                   Int
  validFrom                 DateTime  @map("valid_from") @db.Date
  validTo                   DateTime? @map("valid_to") @db.Date
  lastName                  String    @map("last_name") @db.VarChar(120)
  firstName                 String    @map("first_name") @db.VarChar(120)
  birthDate                 DateTime  @map("birth_date") @db.Date
  registeredSex             String    @map("registered_sex") @db.Char(1)
  nationality               String    @default("Argentina") @db.VarChar(80)
  maritalStatus             String    @map("marital_status") @db.VarChar(40)
  address                   String    @db.VarChar(250)
  locality                  String    @db.VarChar(100)
  province                  String    @db.VarChar(80)
  postalCode                String    @map("postal_code") @db.VarChar(20)
  phone                     String?   @db.VarChar(50)
  email                     String?   @db.VarChar(150)
  contractType              String    @map("contract_type") @db.VarChar(60)
  hiringModalityCode        String    @default("001") @map("hiring_modality_code") @db.Char(3)
  jobPosition               String    @map("job_position") @db.VarChar(120)
  scheduleType              String    @map("schedule_type") @db.VarChar(40)
  habitualSchedule          String    @map("habitual_schedule") @db.VarChar(120)
  weeklyHours               Decimal   @default(48.00) @map("weekly_hours") @db.Decimal(6, 2)
  remunerationModality      String    @map("remuneration_modality") @db.VarChar(20)
  remunerationUnit          String    @map("remuneration_unit") @db.VarChar(20)
  paymentFrequency          String    @map("payment_frequency") @db.VarChar(20)
  customMonthlyHoursDivisor Decimal?  @map("custom_monthly_hours_divisor") @db.Decimal(8, 2)
  workplaceLocation         String    @map("workplace_location") @db.VarChar(150)
