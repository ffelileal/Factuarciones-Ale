{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/desktop/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api?__route=/api/v1/:path*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
