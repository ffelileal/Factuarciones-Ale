{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AR-Payroll Sueldos Argentina",
  "version": "1.0.0",
  "identifier": "ar.estudiocontable.payroll",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sistema Integral de Gestión de Personal y Liquidación de Sueldos — Argentina",
        "width": 1366,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4000 https://*; style-src 'self' 'unsafe-inline'"
    }
  }
}
